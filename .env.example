# Oracle MWT Trader - Phase 1 Configuration
# Copy to .env (never commit .env with real values)

# Application
APP_NAME=Oracle MWT Trader
PHASE=observe_only
LIVE_EXECUTION=false

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///oracle_mwt.db

# Conviction Engine
CONVICTION_THRESHOLD=0.75
WINDOW_MINUTES=15
MIN_CLUSTER_SIZE=2

# Paper Trading
STARTING_BALANCE=100000
DAILY_PROFIT_CAP=10000

# Active Assets (SOL, BTC, ETH, HYPE only for Phase 1)
ACTIVE_ASSETS=SOL,BTC,ETH,HYPE

# Demo Settings
DEMO_ENABLE=true
DEMO_SIGNAL_THRESHOLD=0.75
