# Environment variables - Copy to .env (never commit .env with real values)
# This file contains NO secrets - it's safe to commit

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

# Storage
STORAGE_TYPE=memory
# STORAGE_TYPE=sqlite
# DATABASE_URL=sqlite:///./oracle_mwt.db

# Conviction Engine
CONVICTION_WINDOW_MINUTES=60
MIN_CLUSTER_SIZE=2
CONVICTION_THRESHOLD=0.65

# Assets (Phase 1)
ACTIVE_ASSETS=SOL,BTC,ETH,HYPE

# Mock Data
USE_MOCK_DATA=true
MOCK_EVENTS_PER_MINUTE=5

# API Config
API_VERSION=v1
ENABLE_DOCS=true
